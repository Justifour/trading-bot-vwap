# Copy to .env and fill in. NEVER commit .env.

# ---- Lighter mainnet (runtime ignores LIGHTER_URL — mainnet-only) ----
# LIGHTER_URL only for setup_api_key.py one-off setup
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=4
LIGHTER_API_PRIVATE_KEY=

# One-time only for setup_api_key.py (wallet key — NOT stored by the bot):
# ETH_ADDRESS=0x...
# ETH_PRIVATE_KEY=0x...

# ---- Telegram ----
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---- Strategy ----
# STRATEGY=hybrid

# ---- persistence (Railway: mount volume at /data) ----
# DB_PATH=/data/trades.db

# ---- candles (default binance — reliable from cloud; backtest ref = Bybit CSV) ----
# DATA_SOURCE=binance

# ---- Lighter proxy (Railway/US → need EU SOCKS5, e.g. socks5://host:port) ----
# LIGHTER_PROXY=socks5://user:pass@host:port

# ---- Binance proxy (optional; defaults to LIGHTER_PROXY — needed on Railway US, Binance 451) ----
# BINANCE_PROXY=socks5h://user:pass@host:port

# ---- Bybit proxy (only if DATA_SOURCE=bybit) ----
# BYBIT_PROXY=socks5://user:pass@host:port
